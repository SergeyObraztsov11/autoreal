# Насколько подробно писать логи:
#   silent — ничего
#   error  — только ошибки
#   warn   — ошибки и предупреждения
#   info   — плюс обычные события (заявка принята и т.п.)
#   debug  — плюс отладка (максимум подробности)
NUXT_LOG_LEVEL=info

# Сколько дней хранить файлы логов
NUXT_LOG_RETENTION_DAYS=14

# Заявки: максимум с одного IP за окно
NUXT_RATE_LIMIT_MAX=5
NUXT_RATE_LIMIT_WINDOW_MINUTES=15

# Часовой пояс для логов и дат в заявках (IANA)
NUXT_APP_TIMEZONE=Europe/Moscow

# Telegram: уведомления о новых заявках и отзывах с сайта.
# Токен — у @BotFather. Chat id — личка или группа; несколько через запятую.
# Пока пусто — канал молчит, формы работают как обычно.
NUXT_TELEGRAM_BOT_TOKEN=
NUXT_TELEGRAM_CHAT_ID=
